# Copy this file to .env and fill it in. Never commit .env.

# Supabase: click Connect -> "Shared pooler" -> copy the URI, then replace
# [YOUR-PASSWORD] with your database password.
# IMPORTANT: use a password with only letters and numbers. Symbols such as
# @ # % / break the connection string.
DATABASE_URL=postgresql://postgres.xxxx:YOUR_PASSWORD@aws-0-xx.pooler.supabase.com:6543/postgres

# Which websites may call this API (comma-separated, no trailing slash).
# Locally the React app runs on 5173. After deploying, add your Vercel URL.
CORS_ORIGINS=http://localhost:5173
